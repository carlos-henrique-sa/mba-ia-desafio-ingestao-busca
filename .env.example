# Provedores (prioridade automatica):
#   1. OPENAI_API_KEY real    -> usa OpenAI
#   2. GOOGLE_API_KEY         -> usa Google
#   3. nenhuma das duas       -> usa LLM local (LM Studio)
# Copie este arquivo para .env e preencha apenas o que for usar.

# --- Local (LM Studio) ---
OPENAI_API_KEY=lm-studio
OPENAI_BASE_URL=http://localhost:1234/v1
LLM_LOCAL_MODEL=google/gemma-4-e2b
OPENAI_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# --- OpenAI (opcional: use sua chave real) ---
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Google (opcional) ---
# GOOGLE_API_KEY=...
# GOOGLE_CHAT_MODEL=gemini-2.5-flash
# GOOGLE_EMBEDDING_MODEL=models/embedding-001

# Database
PGVECTOR_URL=postgresql://postgres:postgres@localhost:5432/rag
PGVECTOR_COLLECTION=document_embeddings

# PDF
PDF_PATH=document.pdf
